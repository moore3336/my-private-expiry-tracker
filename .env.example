NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Generate a long random value; never commit the real secret.
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Optional Google sign-in. Add the callback URL to Google Cloud OAuth settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://expiry-tracker-web-production.up.railway.app/auth/google/callback

# Optional AI-powered support replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
